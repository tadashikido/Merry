# Copie para .env na VPS (chmod 600) e preencha. Nunca versione o .env.
# Os segredos ficam vazios aqui de propósito: o docker-compose.prod.yml recusa subir sem eles.
# Gere cada segredo na própria VPS ou na sua máquina, nunca reaproveite valores de outro ambiente.

DOMINIO=celebri.exemplo.com.br
WEB_PORTA=8090
POSTGRES_DB=casamento
POSTGRES_USER=casamento

# gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# gere com: openssl rand -base64 48
JWT_CHAVE_ASSINATURA=

# gere com: openssl rand -base64 32 (diferente da chave JWT; guarde uma cópia fora da VPS)
DADOS_SENSIVEIS_CHAVE=

EMAIL_REMETENTE=nao-responda@celebri.exemplo.com.br
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORTA=587
SMTP_USAR_SSL=true
SMTP_USUARIO=
SMTP_SENHA=
