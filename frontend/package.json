{
  "name": "celebri-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "lint:corrigir": "eslint . --fix",
    "test": "vitest run",
    "test:observar": "vitest",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test --project=simulado",
    "test:e2e:integrado": "playwright test --project=integrado",
    "test:e2e:visivel": "playwright test --project=integrado --headed",
    "test:e2e:interface": "playwright test --ui",
    "test:e2e:instalar": "playwright install chromium",
    "e2e:ambiente:subir": "docker compose --project-directory .. -f ../docker-compose.yml -f ../docker-compose.e2e.yml up -d --build db email api",
    "e2e:ambiente:derrubar": "docker compose --project-directory .. -f ../docker-compose.yml -f ../docker-compose.e2e.yml stop db email api"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "~5.3.0",
    "@fontsource-variable/jost": "~5.3.0",
    "@primeuix/themes": "~2.0.3",
    "pinia": "^4.0.3",
    "primevue": "~4.5.5",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
